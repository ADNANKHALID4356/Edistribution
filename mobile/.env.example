# Mobile app environment (copy to .env for overrides)
# Used when running: npm start / Expo Go

# Local PC LAN IP — run: ipconfig  (physical phone cannot use localhost)
EXPO_PUBLIC_API_HOST=10.8.128.217

# Same port as your local backend (desktop uses 5000; server.js default is 5001)
EXPO_PUBLIC_API_PORT=5000

# Or set full URL instead of host+port:
# EXPO_PUBLIC_API_URL=http://10.8.128.217:5000/api

# Force VPS even in dev (normally only for testing production API):
# EXPO_PUBLIC_USE_VPS=true

# Android emulator maps host localhost to 10.0.2.2:
# EXPO_PUBLIC_API_HOST=10.0.2.2
# EXPO_PUBLIC_API_PORT=5000
