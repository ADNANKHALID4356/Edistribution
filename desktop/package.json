{
  "name": "distribution-management-system",
  "version": "1.0.1",
  "description": "Professional distribution management system for warehouse and sales operations",
  "author": "Ummahtechinnovations",
  "private": true,
  "main": "electron-client.js",
  "homepage": "./",
  "dependencies": {},
  "engines": {
    "node": ">=18.0.0 <=22.x"
  },
  "scripts": {
    "start": "cross-env DISABLE_ESLINT_PLUGIN=true GENERATE_SOURCEMAP=false BROWSER=none node node_modules/react-scripts/bin/react-scripts.js start",
    "build": "cross-env GENERATE_SOURCEMAP=false DISABLE_ESLINT_PLUGIN=true CI=true node node_modules/react-scripts/bin/react-scripts.js build",
    "build:prod": "node scripts/build-production.js",
    "app": "node_modules\\.bin\\electron.cmd .",
    "test": "node node_modules/react-scripts/bin/react-scripts.js test",
    "eject": "react-scripts eject",
    "electron": "npm run app",
    "electron:dev": "concurrently \"cross-env BROWSER=none npm start\" \"wait-on http://localhost:3000 && cross-env USE_DEV_SERVER=true .\\node_modules\\.bin\\electron.cmd .\"",
    "electron:build": "npm run build && electron-builder"
  },
  "eslintConfig": {
    "extends": [
      "react-app",
      "react-app/jest"
    ]
  },
  "browserslist": {
    "production": [
      ">0.2%",
      "not dead",
      "not op_mini all"
    ],
    "development": [
      "last 1 chrome version",
      "last 1 firefox version",
      "last 1 safari version"
    ]
  },
  "devDependencies": {
    "@craco/craco": "^7.1.0",
    "@emotion/react": "^11.14.0",
    "@emotion/styled": "^11.14.1",
    "@headlessui/react": "^2.2.9",
    "@heroicons/react": "^2.2.0",
    "@mui/icons-material": "^7.3.6",
    "@mui/material": "^7.3.6",
    "@tailwindcss/postcss": "^4.1.17",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.0",
    "@testing-library/user-event": "^13.5.0",
    "autoprefixer": "^10.4.22",
    "axios": "^1.13.2",
    "concurrently": "^9.2.1",
    "cross-env": "^10.1.0",
    "electron": "^39.2.4",
    "electron-builder": "^26.0.12",
    "electron-is-dev": "^3.0.1",
    "electron-packager": "^17.1.2",
    "jspdf": "^3.0.4",
    "jspdf-autotable": "^5.0.2",
    "lucide-react": "^0.553.0",
    "postcss": "^8.5.6",
    "react": "^19.2.3",
    "react-dom": "^19.2.3",
    "react-router-dom": "^7.9.5",
    "react-scripts": "5.0.1",
    "webpack": "5.64.4",
    "webpack-dev-server": "4.6.0",
    "tailwindcss": "^3.3.0",
    "wait-on": "^9.0.3",
    "web-vitals": "^2.1.4"
  },
  "build": {
    "appId": "com.ummahtechinnovations.distribution",
    "productName": "Distribution Management System",
    "copyright": "Copyright © 2025 Ummahtechinnovations",
    "directories": {
      "buildResources": "build",
      "output": "dist-standalone"
    },
    "files": [
      "build/**/*",
      "electron-client.js",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "build",
        "to": "app",
        "filter": [
          "**/*"
        ]
      }
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "signAndEditExecutable": false,
      "forceCodeSigning": false,
      "icon": "build/logo512.png",
      "artifactName": "${productName}-Setup-${version}.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "allowElevation": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Distribution System",
      "deleteAppDataOnUninstall": false,
      "perMachine": false,
      "runAfterFinish": true
    }
  }
}
